{
  "schema": "gpudrive_transformer_ppo_config",
  "schema_version": 1,
  "purpose": "tiny_training_smoke_only",
  "research_claims_allowed": false,
  "methodology_source": {
    "repository": "https://github.com/soreng25/Adversarial-Transformer-PPO-agent-in-Cartpole.git",
    "commit": "315b14a90b252ba416eb329e8003d5926806ba67"
  },
  "approved_choices": {
    "approved_at": "2026-08-11",
    "victim": "pinned_pretrained_ppo_slot0_sdc",
    "intervention": "decoded_physical_control_residual",
    "failure": "victim_vehicle_nonvehicle_or_road_object_contact",
    "eligibility": "nominal_clean_goal_success",
    "adversary_information": "current_victim_observation_plus_previous_control_and_disturbance"
  },
  "environment": {
    "scene_source": "pinned_smoke_scene",
    "num_worlds": 1,
    "max_controlled_agents": 1,
    "victim_slot": 0,
    "episode_horizon": 91,
    "decision_period_steps": 1,
    "collision_behavior": "ignore",
    "background_behavior": "logged_trajectory_playback",
    "stop_on_first_failure": true
  },
  "intervention": {
    "dimensions": 2,
    "names": ["delta_acceleration", "delta_steering"],
    "bounds": [0.667, 0.262],
    "nominal_order": ["acceleration", "steering", "head_angle"],
    "final_acceleration_envelope": [-4.0, 4.0],
    "final_steering_envelope": [-3.142, 3.142],
    "head_angle_rule": "preserve_nominal",
    "apply_after_discrete_decode": true,
    "requantize": false
  },
  "prior": {
    "family": "tanh_squashed_normal",
    "base_mean": [0.0, 0.0],
    "base_std": [0.5, 0.5],
    "density": "exact_change_of_variables",
    "reward_term": "nll_excess_from_zero_disturbance",
    "epsilon": 1e-06
  },
  "failure": {
    "scope": "victim_only",
    "post_step_raw_info_indices": {
      "road_object_contact": 0,
      "vehicle_collision": 1,
      "nonvehicle_collision": 2,
      "goal": 3
    },
    "failure_if_any": [
      "road_object_contact",
      "vehicle_collision",
      "nonvehicle_collision"
    ],
    "goal_is_failure": false,
    "horizon_is_failure": false,
    "safety_wins_goal_ties": true
  },
  "eligibility": {
    "require_nominal_clean_goal": true,
    "zero_disturbance": [0.0, 0.0],
    "exclude_initial_event": true
  },
  "token": {
    "victim_observation_dim": 2984,
    "previous_nominal_command_dim": 3,
    "previous_applied_disturbance_dim": 2,
    "token_dim": 2989,
    "history_length": 50,
    "current_victim_action_visible": false,
    "initial_previous_values": "zeros"
  },
  "model": {
    "d_model": 64,
    "nhead": 1,
    "num_layers": 1,
    "dim_feedforward": 64,
    "dropout": 0.0,
    "activation": "relu",
    "latent_name": "pre_actor_features",
    "action_dimensions": 2,
    "initial_log_std": -0.5,
    "min_log_std": -5.0,
    "max_log_std": 1.0
  },
  "reward": {
    "failure_bonus": 1.0,
    "nll_coefficient": 0.01,
    "horizon_reward": 0.0,
    "calibration_status": "smoke_only_not_approved_for_research_claims"
  },
  "ppo": {
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "learning_rate": 0.0003,
    "clip_ratio": 0.2,
    "value_clip": 0.2,
    "value_coefficient": 0.5,
    "entropy_coefficient": 0.0,
    "max_grad_norm": 0.5,
    "update_epochs": 4,
    "minibatch_size": 128,
    "normalize_advantages": true
  },
  "training": {
    "iterations": 2,
    "transitions_per_iteration": 512,
    "checkpoint_every_iterations": 1,
    "deterministic_adversary_evaluation": true,
    "seed": 42,
    "device": "cuda"
  },
  "unsettled_for_research_scale": [
    "dataset_and_scene_cohort",
    "reward_scale_calibration",
    "number_of_training_seeds",
    "total_training_transitions"
  ]
}
